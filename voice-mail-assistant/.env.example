# Copy to .env and fill in. Never commit .env.

# --- Required in production -------------------------------------------------
# Generate both with: python manage.py generate-key
SECRET_KEY=
# Losing or changing ENCRYPTION_KEY makes saved App Passwords and API keys unreadable.
ENCRYPTION_KEY=
# The public address of the site. Must be https for the microphone to work.
BASE_URL=http://localhost:5000
DATABASE_URL=sqlite:///vma.db

# --- Google sign-in ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay ---------------------------------------------------------------
# Leave empty to run without billing (the assistant is then free to use).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create with: python manage.py create-plan
RAZORPAY_PLAN_ID=
# Razorpay Dashboard > Webhooks. URL: <BASE_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
PLAN_PRICE_DISPLAY=$5
PLAN_AMOUNT_MINOR=500
PLAN_CURRENCY=USD
TRIAL_DAYS=30

# --- Other ------------------------------------------------------------------
SUPPORT_EMAIL=support@example.com
# Bump when the Terms or Privacy Policy change; everyone is asked to consent again.
POLICY_VERSION=2026-10-01

# --- Development only -------------------------------------------------------
# Sample inbox and canned AI, no Gmail or AI credentials needed.
DEMO_MODE=0
# Sign in without Google. Never enable in production.
DEV_LOGIN=0
